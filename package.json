{
  "name": "url-shortener",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "build": "npm run clean && npm run build:client && npm run build:server",
    "build:client": "vite build && node scripts/precompress-assets.mjs",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "load:links:50": "npm run build && node scripts/links-load-test.mjs 50 50",
    "load:links:200": "npm run build && node scripts/links-load-test.mjs 200 50",
    "load:links:500": "npm run build && node scripts/links-load-test.mjs 500 50",
    "load:live:50": "npm run build && node scripts/live-load-test.mjs 50 50",
    "load:live:200": "npm run build && node scripts/live-load-test.mjs 200 50",
    "load:live:500": "npm run build && node scripts/live-load-test.mjs 500 50",
    "load:live:word-cloud": "npm run build && node scripts/live-load-test.mjs 200 50 word_cloud",
    "load:live:open": "npm run build && node scripts/live-load-test.mjs 200 50 open_answer",
    "load:live:history": "npm run build && node scripts/live-history-test.mjs 2000 50",
    "load:pages:50": "npm run build && node scripts/pages-load-test.mjs 50 50",
    "load:pages:200": "npm run build && node scripts/pages-load-test.mjs 200 50",
    "load:pages:500": "npm run build && node scripts/pages-load-test.mjs 500 50",
    "verify:production": "npm run build && node scripts/verify-production.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/csrf-protection": "^7.1.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.6",
    "@vueuse/core": "^14.3.0",
    "apexcharts": "^5.12.0",
    "argon2": "^0.44.0",
    "fastify": "^5.12.5",
    "nanoid": "^5.1.16",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "ua-parser-js": "^2.0.10",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.15",
    "vue-router": "^5.0.7",
    "vue3-apexcharts": "^1.11.1"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.19.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  }
}
